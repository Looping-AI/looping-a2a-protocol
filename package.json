{
  "name": "@dynamicagents/g2a-protocol",
  "version": "0.4.2",
  "description": "Zero-dependency wire contract for Dynamic Agents' gatekeeper-to-agent link: the claim names, well-known paths and audience rule of its A2A authentication, and the parts a human-in-the-loop question travels in.",
  "keywords": [
    "a2a",
    "agent2agent",
    "ai-agents",
    "wire-contract",
    "jwt",
    "jwks",
    "eddsa",
    "zero-trust",
    "human-in-the-loop"
  ],
  "license": "Apache-2.0",
  "author": "Dynamic Agents",
  "homepage": "https://github.com/dynamicagents/g2a-protocol#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dynamicagents/g2a-protocol.git"
  },
  "bugs": {
    "url": "https://github.com/dynamicagents/g2a-protocol/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check": "prettier --check . && eslint . && tsc && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:exports": "node scripts/verify-exports.mjs",
    "prepack": "npm run build && npm run verify:exports",
    "prepublishOnly": "npm run check && npm test && npm run verify:exports",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "allowScripts": {
    "fsevents": false
  }
}
